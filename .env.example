# Use the SAME Supabase project as Plekxa Enterprise OS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Required on the server for reliable CMS reads and contact-to-CRM writes.
# Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional email alert. The enquiry is still stored in support_requests without Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@plekxa.com
CONTACT_FROM_EMAIL=Plekxa Website <website@plekxa.com>
