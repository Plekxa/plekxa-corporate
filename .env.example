# Required: same Supabase project used by Plekxa Enterprise
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Strongly recommended for the server-side contact endpoint and CMS reads.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: sends an email notification after the enquiry is stored.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@plekxa.com
CONTACT_FROM_EMAIL=Plekxa Website <website@plekxa.com>
